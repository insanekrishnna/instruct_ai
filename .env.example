# Database
DATABASE_URL=postgresql://[user]:[password]@[host]/[database]

# Gemini API Keys (need at least one)
GEMINI_API_KEY=your_api_key_here
GEMINI_API_KEY_1=optional_second_key
GEMINI_API_KEY_2=optional_third_key
GEMINI_API_KEY_3=optional_fourth_key

# Development Mode - Disable real API calls
# Set to 'true' to use mock data instead of calling Gemini API
# Useful when quota is exhausted or during development
MOCK_GEMINI=false

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here_generate_with_openssl_rand_hex_32
